---
import SectionHead from "./SectionHead.astro";
import { community } from "../data/site";

const icons: Record<string, string> = {
    mic: `<path d="M12 3v12M8 7v4a4 4 0 0 0 8 0V7M12 15v6M8 21h8"/>`,
    video: `<rect x="3" y="6" width="18" height="12" rx="3"/><path d="M10 9.5v5l4.5-2.5z"/>`,
    pen: `<path d="M4 20h16M6 16l9.5-9.5a2.1 2.1 0 0 1 3 3L9 19H6z"/>`,
    code: `<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>`,
};
---

<section class="section section--tight" id="community">
    <div class="container">
        <SectionHead eyebrow="Beyond the day job" title="Learn it. Build it. Share it."/>
        <div class="community">
            {community.map((item, i) => {
                const Tag = "href" in item ? "a" : "div";
                const external = "href" in item && item.href.startsWith("http");
                const linkProps = "href" in item ? { href: item.href, ...(external && { target: "_blank", rel: "noopener" }) } : {};
                return (
                    <Tag class="tile glass glass--interactive reveal" style={`--i:${i}`} {...linkProps}>
                        <span class="tile__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" set:html={icons[item.icon]}/>
                        </span>
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                        {"cta" in item && <span class="tile__go">{item.cta} →</span>}
                    </Tag>
                );
            })}
        </div>
    </div>
</section>
