---
import { Image } from "astro:assets";
import Drawer from "./Drawer.astro";
import type { Project } from "../data/site";

interface Props {
    project: Project;
}

const { project } = Astro.props;
const titleId = `p-${project.id}-t`;
const eyebrow = project.eyebrow.split(" · ")[0];
---

<Drawer id={`p-${project.id}`} labelledby={titleId}>
    <article class="drawer__body">
        <p class="eyebrow">{eyebrow}</p>
        <h2 id={titleId} set:html={project.titleHtml ?? project.title}/>
        {project.detailImage && (
            <Image src={project.detailImage} alt={project.detailAlt ?? ""} widths={[560, 1000]}
                   sizes="(max-width: 767px) 100vw, 500px" loading="lazy"/>
        )}
        {project.details.map((paragraph) => <p>{paragraph}</p>)}
        {project.highlights && (
            <ul class="drawer__list">{project.highlights.map((point) => <li>{point}</li>)}</ul>
        )}
        {project.tags && (
            <ul class="tags" aria-label="Technologies">{project.tags.map((tag) => <li>{tag}</li>)}</ul>
        )}
        {project.link && (
            <a class="btn btn--primary" href={project.link.href} target="_blank" rel="noopener">{project.link.label}</a>
        )}
    </article>
</Drawer>
