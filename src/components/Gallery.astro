---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import SectionHead from "./SectionHead.astro";
import { gallery } from "../data/gallery";

// Lazy glob: only the files listed in gallery.ts get imported (and processed).
// Avoid reading properties of the image metadata here: Astro then keeps the full-size original in the build.
const files = import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*.{jpg,jpeg,JPG,JPEG,png}");
const loaders = new Map(Object.entries(files).map(([path, load]) => [path.split("/").pop()!, load]));

const items = await Promise.all(
    gallery.map(async (item) => {
        const load = loaders.get(item.file);
        if (!load) throw new Error(`Gallery image not found: src/assets/gallery/${item.file}`);
        return { ...item, src: (await load()).default };
    }),
);

// Build-time split; site.js reshuffles across both rows on every visit.
const rows = [items.filter((_, i) => i % 2 === 0), items.filter((_, i) => i % 2 === 1)];
---

<section class="section" id="gallery">
    <div class="container">
        <SectionHead eyebrow="Gallery" title="Moments from the stage and the hallway."/>
    </div>

    <div class="reel" data-reel>
        {rows.map((row, r) => (
            <div class:list={["reel__row reveal", { "reel__row--ltr": r === 0 }]} style={`--i:${r}`}>
                <div class="reel__track">
                    {row.map((item) => (
                        <button type="button" class="g-item" data-event={item.event} data-caption={item.caption}
                                aria-label={`Open photo: ${item.caption}, ${item.event}`}>
                            {/* The 1600w rendition is only fetched by the lightbox (it reads the largest srcset entry). */}
                            <Image src={item.src} alt={`${item.caption} - ${item.event}`} widths={[400, 800, 1600]}
                                   sizes="(max-width: 767px) 300px, 520px" quality={78}/>
                            <span class="g-item__caption"><em>{item.event}</em>{item.caption}</span>
                        </button>
                    ))}
                </div>
            </div>
        ))}
    </div>
    <p class="reel__hint reveal">Hover to pause · click any photo to view it full screen</p>
</section>

<dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <button class="lightbox__btn lightbox__btn--close" type="button" data-lightbox="close" aria-label="Close">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <figure class="lightbox__stage">
        <img class="lightbox__img" alt=""/>
        <figcaption class="lightbox__caption">
            <em class="lightbox__event"></em>
            <span class="lightbox__text"></span>
            <span class="lightbox__count"></span>
        </figcaption>
    </figure>
    <button class="lightbox__btn lightbox__btn--prev" type="button" data-lightbox="prev" aria-label="Previous photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>
    </button>
    <button class="lightbox__btn lightbox__btn--next" type="button" data-lightbox="next" aria-label="Next photo">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>
    </button>
</dialog>
